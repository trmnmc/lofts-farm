{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lofts-farm",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "farm.fenley.ai",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
